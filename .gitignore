node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb
*.log

# === Credentials / secrets ===================================================
#
# Open-source repo: assume nothing under these patterns is ever safe
# to commit, regardless of which subdir it lives in. Refuse first,
# whitelist exceptions explicitly if ever needed.
.env
.env.*
!.env.example
!.env.*.example
.netrc
*.pem
*.key
!*.pub.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
known_hosts
*.token
*.secret
secrets.*
credentials.*
auth.json
service-account*.json
gcp-key*.json
*.local.json
*.local.toml
*.local.yaml
*.local.yml

# === OS / editor scratch =====================================================
.DS_Store
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
*.bak
*.swp
*.swo
.#*
\#*\#

# === Shell / REPL history (commonly auto-dropped in $CWD) ====================
.bash_history
.zsh_history
.python_history
.node_repl_history
.lesshst
.viminfo

# === IDE config dirs =========================================================
#
# Open-source posture: blanket-ignore every IDE config dir, then
# whitelist only known-safe shared content (`.cursor/rules/*.mdc`
# is the de-facto place for team-shared AI rules). All other files
# inside (mcp.json, cli-config.json, workspace.xml, etc.) routinely
# contain API tokens, MCP server credentials, or personal prefs and
# must never be committed.
.idea/
# Use `dir/*` instead of `dir/` so the re-includes below can punch
# back through. (Git won't re-include a path whose parent directory
# was excluded.)
.vscode/*
!.vscode/extensions.json
.cursor/*
!.cursor/rules/
.cursor/rules/*
!.cursor/rules/**/*.mdc
!.cursor/rules/**/
.cursor-server/

# === Agent / CLI session scratch directories =================================
#
# Every modern coding-agent CLI drops per-session sandboxes,
# worktrees, chat history, indexes, or cache somewhere. Anything
# inside these is per-developer or per-session AND frequently
# contains the agent's stored API token. Never committed.
#
# Historical incident: PR #20 (squash-merged 2026-05-28) brought two
# stray files under `.claire/worktrees/...` and `.clone/worktrees/...`
# into the index because neither pattern was ignored at the time.
# The first attempt to fix (cf01980) only removed the files from the
# index but failed to actually update .gitignore; this section is
# the consolidated, more-aggressive fix.
#
# Patterns match BOTH `.foo/` (directory variants) AND `.foo*` (loose
# files some agents drop at repo root, e.g. `.aider.chat.history.md`,
# `.claude.json`).
.clide*
.clideignore
.tide*
.deeptide/
!.deeptide/.gitkeep
.claude*
.claire*
.clone*
.cline*
.codex*
.continue*
.aider*
.windsurf*
.qoder*
.opencode*
.gemini*
.copilot*
.zed*
# Defensive wildcard for the historical leak shape — any agent CLI
# that drops a per-session sandbox under a `worktrees/` parent we
# haven't enumerated above.
**/worktrees/agent-*/
# =============================================================================
target/
**/*.rs.bk

# `deeptide-rs` npm package: the postinstall downloader drops the
# platform-specific Rust binary into npm/deeptide-rs/binary/ on
# `npm install`. Tracking it would balloon the repo and is the
# release pipeline's responsibility, not git's.
npm/deeptide-rs/binary/

# Native runtime build outputs. Source under native/ is intentionally tracked.
native/ds4/ds4
native/ds4/ds4-server
native/ds4/ds4_test
native/ds4/*.o
native/ds4/gguf/
native/ds4/*.gguf
native/dsgo/.build/
native/dsgo/models/
native/dsgo/*.log
native/dsgo/anthropic_gateway/
